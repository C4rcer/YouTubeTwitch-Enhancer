{
  "manifest_version": 2,
  "name": "YouTube/Twitch Enhancer",
  "version": "4.7.1",
  "description": "Block channels, categories, tags & keywords on YouTube & Twitch. Hide Shorts & watched videos, auto-claim points/drops/moments, emotes, chat filters, speed control, compressor, cinema mode. Opt-in SponsorBlock, DeArrow & RYD.",

  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-blocker@c4rcer",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://www.twitch.tv/*",
    "*://m.twitch.tv/*",
    "*://clips.twitch.tv/*",
    "*://api.betterttv.net/*",
    "*://api.frankerfacez.com/*",
    "*://7tv.io/*"
  ],

  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["src/watched-db.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://www.twitch.tv/*", "*://m.twitch.tv/*", "*://clips.twitch.tv/*"],
      "js": ["src/twitch.js"],
      "css": ["src/twitch.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "background": {
    "scripts": ["src/common.js", "src/background.js"]
  },

  "browser_action": {
    "default_title": "YouTube/Twitch Enhancer",
    "default_popup": "src/popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },

  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
